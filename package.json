{
  "name": "my-parking",
  "main": "index.js",
  "version": "1.0.0",
  "description": "Snap where you parked, see it on your widget, lock screen and Dynamic Island, and share it with someone you trust.",
  "license": "MIT",
  "dependencies": {
    "@expo/ui": "~57.0.19",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-contacts": "~57.0.6",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.19",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.20",
    "firebase": "^12.19.0",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.4.2",
    "libphonenumber-js": "^1.13.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-parking \"node test/rules.test.mjs\"",
    "test:unfriend": "npx --yes firebase-tools emulators:exec --only firestore,functions,storage --project demo-parking \"node test/unfriend.test.mjs\"",
    "test": "npm run typecheck && npm run check:i18n && npm run test:rules && npm run test:unfriend && npm run test:delete",
    "test:delete": "npx --yes firebase-tools emulators:exec --only auth,firestore,functions,storage --project demo-parking \"node test/delete-account.test.mjs\""
  }
}
