# Copy to .env and fill in. Every EXPO_PUBLIC_* value is compiled into the app and is therefore PUBLIC by design:
# Firebase web config is an identifier, not a secret. Access is enforced by firestore.rules / storage.rules.
# (Still restrict the API key to your iOS/Android bundle ids in Google Cloud console → APIs & Services → Credentials.)
# Real secrets (APNs key, service accounts, signing certificates) never go in this file or in the repo.

# Firebase console → Authentication → Sign-in method → Google → Web SDK configuration → Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Public site (Firebase Hosting custom domain): share / invite links, legal pages, universal links
EXPO_PUBLIC_SITE_URL=https://your-domain.example
